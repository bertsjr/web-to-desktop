{
  "name": "web-to-desktop-app",
  "version": "2026.6.4",
  "description": "Turn any website into its own Windows desktop application.",
  "main": "main.js",
  "author": "Bert",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win",
    "publish": "electron-builder --win --publish always"
  },
  "build": {
    "appId": "com.bert.webtodesktop",
    "productName": "Web to Desktop",
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "appshell/**/*",
      "assets/**/*"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "bertsjr",
        "repo": "web-to-desktop"
      }
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico"
    }
  },
  "dependencies": {
    "electron-log": "^5.1.5",
    "electron-updater": "^6.2.1"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  }
}
