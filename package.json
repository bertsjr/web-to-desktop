{
  "name": "web-to-desktop-app",
  "version": "2026.7.3",
  "description": "Turn any website into its own Windows desktop application.",
  "main": "main.js",
  "author": "Bert",
  "license": "MIT",
  "scripts": {
    "start": "node scripts/dev.js",
    "dist": "electron-builder --win",
    "publish": "node scripts/publish.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:e2e": "npx playwright test --config playwright.config.js"
  },
  "build": {
    "appId": "com.bert.webtodesktop",
    "productName": "Web to Desktop",
    "files": [
      "main.js",
      "preload.js",
      "google-auth-browser.js",
      "lib/**/*",
      "renderer/**/*",
      "appshell/**/*",
      "picker/**/*",
      "assets/**/*"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "bertsjr",
        "repo": "web-to-desktop"
      }
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico"
    }
  },
  "dependencies": {
    "electron-log": "^5.1.5",
    "electron-updater": "^6.2.1",
    "puppeteer-core": "^25.3.0"
  },
  "devDependencies": {
    "dotenv": "^17.4.2",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "jest": "^30.4.2"
  }
}
